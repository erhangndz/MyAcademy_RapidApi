@model WeatherViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Open Weather Hava Durumu Sorgulama </h1>

<form method="post">
    <input type="text" name="cityName" class="form-control" placeholder="Şehir İsmini Yazın..." required />
    <button class="btn btn-dark">Sorgula</button>
</form>


@if (Model != null)
{
    
    <div class="card text-center">
        <h3 class="card-title">@Model.name Hava Durumu</h3>
        <div class="card-body">
            <ul>
                <li> @Model.main.tempInCelsius C°</li>
                <li>@Model.weather[0].description</li>
            </ul>
        </div>


    </div>




}

